# Supabase Configuration
# Obtén estos valores desde tu proyecto de Supabase en Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Service Role Key (solo para servidor - NO usar en cliente)
# Úsala solo para operaciones administrativas que requieren privilegios elevados
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Feature Flags (opcionales)
# Habilitar todos los bancos en lugar de solo favoritos
# NEXT_PUBLIC_ENABLE_ALL_BANKS=true

# Habilitar módulo de asistencia
# NEXT_PUBLIC_ENABLE_ATTENDANCE=true

# Notion Integration
# Obtén el token desde: https://www.notion.so/my-integrations
# La database debe compartirse con la integración
NEXT_PUBLIC_NOTION_TOKEN=ntn_your-integration-token-here
NEXT_PUBLIC_NOTION_DATABASE_ID=your-database-id-here